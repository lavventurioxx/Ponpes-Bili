rules_version = '2';

service firebase.storage {
	match /b/{bucket}/o {
		function admin() {
			return request.auth != null && (
				request.auth.token.email == 'sabilianggita@gmail.com' ||
				firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
			);
		}

		match /guru/{fileName} {
			allow read: if true;
			allow write: if admin()
				&& request.resource.size < 5 * 1024 * 1024
				&& request.resource.contentType.matches('image/.*');
			allow delete: if admin();
		}

		match /berita/{fileName} {
			allow read: if true;
			allow write: if admin()
				&& request.resource.size < 5 * 1024 * 1024
				&& request.resource.contentType.matches('image/.*');
			allow delete: if admin();
		}

		match /ekskul/{fileName} {
			allow read: if true;
			allow write: if admin()
				&& request.resource.size < 5 * 1024 * 1024
				&& request.resource.contentType.matches('image/.*');
			allow delete: if admin();
		}

		match /prestasi/{fileName} {
			allow read: if true;
			allow write: if admin()
				&& request.resource.size < 5 * 1024 * 1024
				&& request.resource.contentType.matches('image/.*');
			allow delete: if admin();
		}

		match /galeri/{fileName} {
			allow read: if true;
			allow write: if admin()
				&& request.resource.size < 5 * 1024 * 1024
				&& request.resource.contentType.matches('image/.*');
			allow delete: if admin();
		}

		match /pendaftaran/{userId}/{fileName} {
			allow read: if admin() || (request.auth != null && request.auth.uid == userId);
			allow write: if request.auth != null
				&& request.auth.uid == userId
				&& request.resource.size <= 1 * 1024 * 1024
				&& request.resource.contentType.matches('image/.*');
			allow delete: if admin() || (request.auth != null && request.auth.uid == userId);
		}
	}
}